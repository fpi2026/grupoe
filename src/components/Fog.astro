---
/**
 * Neblina en tres capas, como en el diseño (Inicio.dc.html).
 * Se coloca dentro de un contenedor con position: relative.
 * Se detiene sola con prefers-reduced-motion (ver global.css).
 */
---

<div class="fog" aria-hidden="true">
	<div class="fog-layer animate-fog-a" style="top:30%;opacity:.9"></div>
	<div class="fog-layer animate-fog-b" style="top:48%;opacity:.7"></div>
	<div class="fog-layer animate-fog-c" style="top:10%;opacity:.45"></div>
</div>
