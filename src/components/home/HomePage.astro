---
/** Página de Inicio completa; la usan / y /en/. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Attributes from './Attributes.astro';
import Timeline from './Timeline.astro';
import Counters from './Counters.astro';
import Cabins from './Cabins.astro';
import TrifinioSection from './TrifinioSection.astro';
import Awards from './Awards.astro';
import NewsSection from './NewsSection.astro';
import BookingSection from './BookingSection.astro';
import AirSection from './AirSection.astro';
import { inicio } from '../../data/inicio';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const c = inicio[lang];
---

<BaseLayout lang={lang} route="inicio" title={c.meta.title} description={c.meta.description} fullTitle>
	<Hero lang={lang} t={c.hero} />
	<Attributes t={c.attrs} />
	<Timeline lang={lang} t={c.timeline} />
	<Counters t={c.counters} />
	<Cabins lang={lang} t={c.cabins} />
	<TrifinioSection lang={lang} t={c.trifinio} />
	<NewsSection lang={lang} />
	<Awards t={c.awards} />
	<BookingSection lang={lang} t={c.booking} />
	<AirSection lang={lang} t={c.air} />
</BaseLayout>
