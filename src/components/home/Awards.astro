---
/** Reconocimientos y apoyos (placas del Drive, Plan del sitio). La lista se edita en /admin. */
import { Image } from 'astro:assets';
import placas from '../../assets/img/reconocimientos.jpg';
import type { HomeContent } from '../../data/inicio';
import { en, foto, reconocimientos } from '../../data/editable';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
	t: HomeContent['awards'];
}
const { lang, t } = Astro.props;
---

<section aria-labelledby="rec-t" class="bg-surface transition-[background] duration-[.6s]">
	<div class="container-site grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] gap-[clamp(32px,5vw,80px)] py-[clamp(72px,9vw,128px)]">
		<div class="flex flex-col gap-6">
			<h2 id="rec-t" class="m-0 font-serif text-h2 font-normal">{t.title}</h2>
			<Image
				src={placas}
				alt={t.alt}
				widths={[480, 720, 960, 1280]}
				sizes="(min-width: 1000px) 640px, 100vw"
				class="aspect-[4/3] w-full rounded-lg object-cover"
			/>
		</div>
		<ul class="m-0 list-none self-end p-0">
			{
				reconocimientos.map((r) => {
					const entidad = [en(r.entidad, lang), r.anio].filter(Boolean).join(' · ');
					return (
						<li class="flex items-center justify-between gap-4 border-t border-line py-4">
							<span class="flex items-center gap-3 text-[17px]">
								{r.logo && <Image src={foto(r.logo)} alt="" width={80} class="size-10 flex-none rounded-sm bg-white object-contain p-0.5" />}
								{en(r.nombre, lang)}
							</span>
							{entidad && <span class="text-[12.5px] whitespace-nowrap text-muted">{entidad}</span>}
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
