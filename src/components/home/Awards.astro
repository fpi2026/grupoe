---
/** Reconocimientos y apoyos (placas del Drive, Plan del sitio). */
import { Image } from 'astro:assets';
import placas from '../../assets/img/reconocimientos.jpg';
import type { HomeContent } from '../../data/inicio';

interface Props {
	t: HomeContent['awards'];
}
const { t } = Astro.props;
---

<section aria-labelledby="rec-t" class="bg-surface transition-[background] duration-[.6s]">
	<div class="container-site grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] gap-[clamp(32px,5vw,80px)] py-[clamp(72px,9vw,128px)]">
		<div class="flex flex-col gap-6">
			<h2 id="rec-t" class="m-0 font-serif text-h2 font-normal">{t.title}</h2>
			<Image
				src={placas}
				alt={t.alt}
				widths={[480, 720, 960, 1280]}
				sizes="(min-width: 1000px) 640px, 100vw"
				class="aspect-[4/3] w-full rounded-lg object-cover"
			/>
		</div>
		<ul class="m-0 list-none self-end p-0">
			{
				t.items.map((r) => (
					<li class="flex items-baseline justify-between gap-4 border-t border-line py-4">
						<span class="text-[17px]">{r.name}</span>
						{r.by && <span class="text-[12.5px] whitespace-nowrap text-muted">{r.by}</span>}
					</li>
				))
			}
		</ul>
	</div>
</section>
