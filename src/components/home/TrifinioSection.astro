---
/** Tres países, un mismo bosque: mapa 3D del Trifinio y presentación. */
import TrifinioMap from '../TrifinioMap.astro';
import type { Lang } from '../../i18n/ui';
import { localizedPath } from '../../i18n/utils';
import type { HomeContent } from '../../data/inicio';

interface Props {
	lang: Lang;
	t: HomeContent['trifinio'];
}
const { lang, t } = Astro.props;
---

<section aria-labelledby="map-t" class="bg-surface transition-[background] duration-[.6s]">
	<div class="container-site grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-center gap-[clamp(32px,5vw,80px)] py-[clamp(72px,9vw,128px)]">
		<TrifinioMap lang={lang} />
		<div class="flex flex-col gap-[18px]">
			<span class="eyebrow text-amber-ink">{t.eyebrow}</span>
			<h2 id="map-t" class="m-0 font-serif text-h2 font-normal tracking-[-.015em] text-balance">{t.title}</h2>
			<p class="m-0 max-w-[480px] text-pretty text-muted">{t.text}</p>
			<a href={localizedPath('contacto', lang)} class="font-semibold">{t.more} →</a>
		</div>
	</div>
</section>
