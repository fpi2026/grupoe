---
/**
 * Aviso temporal arriba de todas las páginas (por ejemplo, «Acceso cerrado por lluvias»).
 * Se activa y se escribe en /admin → Textos y avisos (src/content/datos/sitio.json).
 * La persona puede cerrarlo; vuelve a aparecer si el texto cambia.
 */
import { sitio, enIdioma } from '../data/sitio';
import type { Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const texto = enIdioma(sitio.aviso.texto, lang).trim();
const alerta = sitio.aviso.tono === 'alerta';
// Identifica el texto para recordar si ya se cerró
let h = 0;
for (const c of texto) h = (Math.imul(h, 31) + c.charCodeAt(0)) | 0;
const clave = `cael-aviso-${(h >>> 0).toString(36)}`;
---

{
	sitio.aviso.activo && texto && (
		<div
			role="note"
			data-aviso={clave}
			class:list={['flex items-center gap-2.5 px-[clamp(14px,3vw,28px)] py-2.5 text-[15px] font-medium', alerta ? 'bg-amber text-[#1A1206]' : 'bg-forest text-on-forest']}
		>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="flex-none">
				<circle cx="12" cy="12" r="10" />
				<path d="M12 8v4M12 16h.01" />
			</svg>
			<span class="flex-1">{texto}</span>
			<button
				type="button"
				data-cerrar-aviso
				aria-label={lang === 'es' ? 'Cerrar aviso' : 'Close notice'}
				class="-my-1.5 size-9 flex-none cursor-pointer border-0 bg-transparent text-xl text-current"
			>
				×
			</button>
		</div>
	)
}

<script>
	const aviso = document.querySelector<HTMLElement>('[data-aviso]');
	if (aviso) {
		const clave = aviso.dataset.aviso!;
		try {
			if (sessionStorage.getItem(clave)) aviso.remove();
		} catch {}
		aviso.querySelector('[data-cerrar-aviso]')?.addEventListener('click', () => {
			aviso.remove();
			try {
				sessionStorage.setItem(clave, '1');
			} catch {}
		});
	}
</script>
