---
/** Detalle de una noticia; lo usan /noticias/<slug>/ y /en/news/<slug>/. */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { newsTags, noticiasUI, formatDate } from '../../data/noticias';
import { newsPath, parseId, type NewsEntry } from '../../lib/noticias';
import { localizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
	entry: NewsEntry;
	/** Idiomas en los que existe la misma noticia publicada. */
	langs: Lang[];
}
const { entry, langs } = Astro.props;
const { lang, slug } = parseId(entry.id);
const t = noticiasUI[lang];
const d = entry.data;
const { Content } = await render(entry);
const paths = Object.fromEntries(langs.map((l) => [l, newsPath(l, slug)]));
---

<BaseLayout
	lang={lang}
	route="noticias"
	title={d.titulo}
	description={d.resumen}
	paths={paths}
	image={d.portada.src}
	ogType="article"
>
	<article class="container-site flex flex-col gap-6 pt-[clamp(56px,8vw,112px)] pb-[clamp(72px,9vw,128px)]">
		<div class="flex max-w-[820px] flex-col gap-6">
			<a href={localizedPath('noticias', lang)} class="self-start font-semibold">← {t.back}</a>
			<span class="eyebrow text-amber-ink">{d.etiquetas.map((tag) => newsTags[tag][lang]).join(' · ')}</span>
			<h1 class="m-0 font-serif text-[clamp(38px,5vw,68px)] leading-[1.02] font-normal tracking-[-.015em] text-balance">{d.titulo}</h1>
			<p class="m-0 font-serif text-[clamp(19px,1.6vw,22px)] text-muted">{d.resumen}</p>
			<p class="m-0 text-sm text-muted">
				{t.published} <time datetime={d.fecha.toISOString().slice(0, 10)}>{formatDate(d.fecha, lang)}</time>
			</p>
			<Image
				src={d.portada}
				alt={d.portadaAlt}
				widths={[480, 820, 1240, 1640]}
				sizes="(min-width: 900px) 820px, 100vw"
				loading="eager"
				class="aspect-[3/2] w-full rounded-lg object-cover"
			/>
			<div class="news-body flex max-w-[680px] flex-col gap-4 text-lg">
				<Content />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.news-body :global(:is(p, ul, ol, blockquote, figure)) {
		margin: 0;
		text-wrap: pretty;
	}
	.news-body :global(:is(ul, ol)) {
		padding-left: 1.3em;
	}
	.news-body :global(ul) {
		list-style: disc;
	}
	.news-body :global(ol) {
		list-style: decimal;
	}
	.news-body :global(h2) {
		margin: 0.6em 0 0;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(26px, 2.6vw, 34px);
		line-height: 1.15;
	}
	.news-body :global(h3) {
		margin: 0.4em 0 0;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 24px;
	}
	.news-body :global(img) {
		width: 100%;
		height: auto;
		border-radius: 8px;
	}
	.news-body :global(blockquote) {
		border-left: 3px solid var(--amber);
		padding-left: 14px;
		font-family: var(--font-serif);
		font-style: italic;
	}
</style>
