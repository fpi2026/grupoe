---
/** Página de Sostenibilidad y aire (Sostenibilidad.dc.html); la usan /sostenibilidad/ y /en/sustainability/. */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AirCard from '../AirCard.astro';
import solarTecho from '../../assets/img/solar-techo.jpg';
import solarBateria from '../../assets/img/solar-bateria.jpg';
import { sostenibilidad } from '../../data/sostenibilidad';
import type { Lang } from '../../i18n/ui';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const c = sostenibilidad[lang];
// Colores de los niveles del ICA (mismos tokens que AirCard)
const icaColors = ['buena', 'moderada', 'sensibles', 'danina', 'muy-danina', 'peligrosa'].map((n) => `var(--color-ica-${n})`);
---

<BaseLayout lang={lang} route="sostenibilidad" title={c.meta.title} description={c.meta.description}>
	<section class="container-site grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-end gap-x-16 gap-y-6 pt-[clamp(56px,8vw,112px)] pb-[clamp(40px,5vw,64px)]">
		<div class="flex flex-col gap-3.5">
			<span class="eyebrow text-amber-ink">{c.intro.eyebrow}</span>
			<h1 class="m-0 font-serif text-h1 font-normal tracking-[-.02em]">
				{c.intro.titleA} <em>{c.intro.titleB}</em>
			</h1>
		</div>
		<p class="m-0 max-w-[520px] text-pretty text-muted">{c.intro.lead}</p>
	</section>

	<section aria-label={c.solar.label} class="container-site grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3">
		<Image src={solarTecho} alt={c.solar.alts[0]} widths={[480, 720, 960]} sizes="(min-width: 960px) 440px, 100vw" loading="eager" class="aspect-[4/5] w-full rounded-lg object-cover" />
		<Image src={solarBateria} alt={c.solar.alts[1]} widths={[480, 720, 960]} sizes="(min-width: 960px) 440px, 100vw" class="aspect-[4/5] w-full rounded-lg object-cover" />
		<div class="flex flex-col justify-between gap-6 rounded-lg bg-surface p-[clamp(24px,3vw,36px)] transition-[background] duration-[.6s]">
			<p class="m-0 font-serif text-[clamp(72px,8vw,120px)] leading-[.9] tracking-[-.03em]">
				5.85<span class="ml-2 text-[.32em] text-amber-ink">kWp</span>
			</p>
			<p class="m-0 text-muted">{c.solar.text}</p>
		</div>
	</section>

	<section aria-labelledby="pr-t" class="container-site py-[clamp(64px,8vw,120px)]">
		<h2 id="pr-t" class="mt-0 mb-9 font-serif text-[clamp(34px,4.4vw,60px)] font-normal">{c.practices.title}</h2>
		<ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-x-12 p-0">
			{
				c.practices.items.map((p) => (
					<li class="flex flex-col gap-2.5 border-t-2 border-ink pt-5 pb-8">
						<span class="text-xs font-semibold tracking-[.14em] text-amber-ink uppercase">{p.kicker}</span>
						<h3 class="m-0 font-serif text-[27px] leading-[1.15] font-medium">{p.title}</h3>
						<p class="m-0 text-muted">{p.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section id="aire" aria-labelledby="ai-t" class="scroll-mt-[130px] bg-surface transition-[background] duration-[.6s]">
		<div class="container-site grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-start gap-[clamp(32px,5vw,80px)] py-[clamp(64px,8vw,120px)]">
			<div class="flex flex-col gap-[18px]">
				<span class="eyebrow text-amber-ink">{c.air.eyebrow}</span>
				<h2 id="ai-t" class="m-0 font-serif text-h2 font-normal text-balance">{c.air.title}</h2>
				<p class="m-0 max-w-[480px] text-muted">{c.air.text}</p>
				<dl class="mt-3 mb-0 flex flex-col">
					{
						c.air.glossary.map((g) => (
							<div class="grid grid-cols-[80px_1fr] gap-3 border-t border-line py-3.5">
								<dt class="font-bold">{g.k}</dt>
								<dd class="m-0 text-[15.5px] text-muted">{g.v}</dd>
							</div>
						))
					}
				</dl>
			</div>
			<AirCard lang={lang} />
		</div>

		<!-- Qué es AireSV (información del sitio de AireSV) -->
		<div class="container-site grid grid-cols-[repeat(auto-fit,minmax(min(100%,440px),1fr))] items-start gap-[clamp(32px,5vw,80px)] pb-[clamp(64px,8vw,120px)]">
			<div class="flex flex-col gap-[18px] border-t-2 border-ink pt-8">
				<h3 class="m-0 font-serif text-[clamp(26px,2.6vw,34px)] font-normal">{c.air.about.title}</h3>
				{c.air.about.text.map((p) => <p class="m-0 max-w-[520px] text-muted">{p}</p>)}
				<ul class="m-0 mt-2 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,210px),1fr))] gap-x-6 gap-y-4 p-0">
					{
						c.air.about.features.map((f) => (
							<li class="flex flex-col gap-1 border-t border-line pt-3">
								<strong class="font-semibold">{f.title}</strong>
								<span class="text-[15.5px] text-muted">{f.text}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div class="flex flex-col gap-[18px] border-t-2 border-ink pt-8">
				<h3 class="m-0 font-serif text-[clamp(26px,2.6vw,34px)] font-normal">{c.air.about.scaleTitle}</h3>
				<p class="m-0 text-muted">{c.air.about.scaleNote}</p>
				<ol class="m-0 flex list-none flex-col p-0">
					{
						c.air.about.levels.map((l, i) => (
							<li class="grid grid-cols-[14px_1fr] gap-x-3 border-t border-line py-3">
								<span aria-hidden="true" class="mt-1.5 size-3.5 rounded-full" style={{ background: icaColors[i] }} />
								<div class="flex flex-col gap-0.5">
									<span>
										<strong class="font-semibold">{l.name}</strong> <span class="text-muted tabular-nums">· {l.range}</span>
									</span>
									<span class="text-[15.5px] text-muted">{l.advice}</span>
								</div>
							</li>
						))
					}
				</ol>
				<p class="m-0 text-sm text-muted">{c.air.about.credit}</p>
			</div>
		</div>
	</section>
</BaseLayout>
