---
/**
 * Panel de contenido (CMS). Solo funciona en el navegador (client:only) y no se indexa.
 * Diseño: diseno/Panel-*.dc.html y diseno/panel.css.
 */
import { getImage } from 'astro:assets';
import '../../styles/panel.css';
import App from '../../admin/App';
import nocheCabana from '../../assets/img/noche-cabana.jpg';

// Foto de la pantalla de inicio de sesión, reducida al compilar
const fondo = await getImage({ src: nocheCabana, width: 1200, format: 'webp' });
---

<!doctype html>
<html lang="es" data-theme="day">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Panel · Cabañas Alpinas El Limo</title>
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} />
		<script is:inline>
			// Mismo tema que el sitio (día / noche), antes de pintar
			try {
				document.documentElement.dataset.theme = localStorage.getItem('cael-theme') === 'night' ? 'night' : 'day';
			} catch (e) {}
		</script>
	</head>
	<body>
		<App client:only="preact" fondoLogin={fondo.src}>
			<p slot="fallback" style="padding:2rem">Cargando el panel…</p>
		</App>
		<noscript><p style="padding:2rem">El panel necesita JavaScript.</p></noscript>
	</body>
</html>
