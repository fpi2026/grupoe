---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Fog from '../../components/Fog.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="inicio">
	<section class="relative overflow-hidden bg-surface section-y">
		<Fog />
		<div class="container-site relative flex flex-col gap-6">
			<p class="eyebrow text-amber-ink">Site under construction</p>
			<h1 class="m-0 font-serif text-display font-normal">
				Cabañas Alpinas <em class="font-light">El Limo</em>
			</h1>
			<p class="m-0 max-w-2xl font-serif text-h3 text-muted">{t('site.tagline')}</p>
		</div>
	</section>
</BaseLayout>
